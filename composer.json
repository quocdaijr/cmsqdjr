{
    "name": "quocdaijr/cmsqdjr",
    "type": "project",
    "description": "CmsQDJr is written in Laravel Framework.",
    "keywords": ["framework", "laravel", "quocdaijr", "cmsqdjr"],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "guzzlehttp/guzzle": "^7.0.1",
        "intervention/image": "^3.0",
        "jeremykenedy/laravel-logger": "^5.0",
        "laravel/framework": "^12.0",
        "laravel/horizon": "^5.28",
        "laravel/telescope": "^5.0",
        "laravel/tinker": "^2.10",
        "league/flysystem-aws-s3-v3": "^3.0",
        "mcamara/laravel-localization": "^2.0",
        "nwidart/laravel-modules": "^11.0",
        "predis/predis": "^2.2",
        "quocdaijr/administration": "*@dev",
        "quocdaijr/category": "*@dev",
        "quocdaijr/core": "*@dev",
        "quocdaijr/dashboard": "*@dev",
        "quocdaijr/file": "*@dev",
        "quocdaijr/post": "*@dev",
        "quocdaijr/tag": "*@dev",
        "spatie/laravel-permission": "^6.0",
        "vladimir-yuldashev/laravel-queue-rabbitmq": "^13.0"
    },
    "suggest": {
        "elasticsearch/elasticsearch": "^8.0 - Optional, for better search performance",
        "quocdaijr/laravel-elasticsearch": "*@dev - Optional, Elasticsearch integration (update to Laravel 12 required)",
        "laravelcollective/html": "^6.4 - Form/HTML helpers (Laravel 10 max, update needed for Laravel 12)"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^3.14",
        "barryvdh/laravel-ide-helper": "^3.0",
        "fakerphp/faker": "^1.23",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.0",
        "orchestra/testbench": "^10.0",
        "phpunit/phpunit": "^11.0",
        "spatie/laravel-ignition": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/",
            "Modules\\": "modules/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "pre-install-cmd": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "Illuminate\\Foundation\\ComposerScripts::postUpdate",
            "@php artisan ide-helper:generate",
            "@php artisan ide-helper:meta"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "wikimedia/composer-merge-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "path",
            "url": "./modules/*"
        },
        {
            "type": "vcs",
            "url": "git@github.com:quocdaijr/laravel-elasticsearch.git"
        }
    ]
}
